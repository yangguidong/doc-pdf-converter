# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# JWT Secret (change in production!)
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Model API Keys (leave empty for mock mode)
RUNWAY_API_KEY=
PIKA_API_KEY=
KLING_API_KEY=
STABILITY_API_KEY=

# App Settings
DEFAULT_SIGNUP_CREDITS=50
MAX_VIDEO_FILE_SIZE_MB=500
